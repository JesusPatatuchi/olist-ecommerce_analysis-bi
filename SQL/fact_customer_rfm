CREATE OR REPLACE TABLE `ers-490608.olist_ecommerce.fct_customer_rfm` AS
--Made a little snapshot to get the Max Date
WITH snapshot_date  AS (
  SELECT MAX(purchase_date) AS max_date
  FROM `ers-490608.olist_ecommerce.stg_orders_consolidated`
),
--used a cross join to add max_date to all diferent customers
customer_summary AS (
  SELECT
    customer_unique_id,
    DATE_DIFF(snapshot_date.max_date,MAX(purchase_date) , DAY) AS recency_days,
    COUNT(DISTINCT order_id ) AS total_orders,
    SUM(total_price_value) AS total_value
  FROM 
    `ers-490608.olist_ecommerce.stg_orders_consolidated`
  CROSS JOIN
  snapshot_date 
  GROUP BY
    customer_unique_id,
    snapshot_date.max_date
), 
--Another CTE to add the the RFM scores
rfm_summary AS (
  SELECT
    customer_unique_id,
    recency_days,
    total_orders,
    total_value,
    NTILE(5) OVER (ORDER BY recency_days DESC) AS r_score,
    NTILE(5) OVER (ORDER BY total_orders) AS f_score,
    NTILE(5) OVER (ORDER BY total_value ) AS m_score
  FROM
    customer_summary
)
--Finally using case to make the categories
SELECT
  customer_unique_id,
  recency_days,
  total_orders,
  total_value,
  r_score,
  f_score,
  m_score,
  CASE
        WHEN r_score >= 4 AND f_score >= 4 THEN 'Champions'
        WHEN r_score >= 3 AND f_score >= 3 THEN 'Loyal Customers'
        WHEN r_score >= 4 AND f_score < 3 THEN 'Recent / New Customers'
        WHEN r_score <= 2 AND f_score >= 3 THEN 'At Risk'
        WHEN r_score <= 2 AND f_score <= 2 THEN 'Lost / Hibernating'
        ELSE 'Potential Loyalists'
        END AS customer_segment
    
FROM
  rfm_summary
ORDER BY
  rfm_summary.recency_days DESC;
