--First creaqte a table with all the required data for a RFM analysis
CREATE OR REPLACE TABLE `ers-490608.olist_ecommerce.stg_orders_consolidated` AS
SELECT
  o.order_id,
  o.customer_id,
  o.order_status,
  c.customer_unique_id,
  c.customer_city,
  c.customer_state,
--Here we extract only the Date
  CAST(o.order_purchase_timestamp AS TIMESTAMP)  AS purchase_timestamp,
  DATE(CAST(o.order_purchase_timestamp AS TIMESTAMP))  AS purchase_date,
  COUNT(i.order_item_id) AS total_items,
  ROUND(SUM(i.price),2) AS total_price_value,
  ROUND(SUM(i.freight_value),2) AS total_freight_value
--Here is the Joining part where I added the tables to gather all info necessary
FROM
  `ers-490608.olist_ecommerce.raw_orders` AS o
INNER JOIN
  `ers-490608.olist_ecommerce.raw_customers` AS c ON o.customer_id = c.customer_id
INNER JOIN
  `ers-490608.olist_ecommerce.raw_order_items` AS i ON o.order_id = i.order_id
-- Used a filter because most orders are cancelled and it's not necessary
WHERE
  o.order_status = 'delivered'
GROUP BY
  o.order_id,
  c.customer_unique_id,
  o.customer_id,
  o.order_status,
  o.order_purchase_timestamp,
  c.customer_city,
  c.customer_state
